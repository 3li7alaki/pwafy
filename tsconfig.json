{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/components/ui/*": ["./stubs/ui/*"],
      "@/lib/utils": ["./stubs/utils.ts"],
      "@/*": ["./registry/*"]
    }
  },
  "include": ["registry", "stubs", "checks"]
}
